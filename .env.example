# Copy to .env, then replace the secret and the DB password.
SECRET_KEY=replace-with-a-random-string-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
HTTPS=False
POSTGRES_DB=kittygram
POSTGRES_USER=kittygram
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Local SQLite: leave POSTGRES_HOST empty. Compose overrides it to db.
POSTGRES_HOST=
POSTGRES_PORT=5432
