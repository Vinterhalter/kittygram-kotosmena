{
  "info": {
    "name": "Kittygram Котосмена полный цикл",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "01 Регистрация хозяина",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{owner_username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set('owner_username', 'owner_' + suffix);",
              "pm.collectionVariables.set('sitter_username', 'sitter_' + suffix);",
              "pm.collectionVariables.set('password', 'Demo-pass-' + suffix + '!');",
              "const now = Date.now();",
              "pm.collectionVariables.set('starts_at', new Date(now - 3600000).toISOString());",
              "pm.collectionVariables.set('due_at', new Date(now + 3600000).toISOString());",
              "pm.collectionVariables.set('ends_at', new Date(now + 86400000).toISOString());",
              "pm.collectionVariables.set('extended_at', new Date(now + 172800000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Регистрация помощника",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{sitter_username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
