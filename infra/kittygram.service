[Unit]
Description=Kittygram Gunicorn
After=network.target
[Service]
User=kittygram
Group=www-data
WorkingDirectory=/opt/kittygram/backend
EnvironmentFile=/opt/kittygram/.env
ExecStart=/opt/kittygram/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 3 --no-control-socket --access-logfile - --error-logfile -
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/kittygram/backend/media /opt/kittygram/backend/private_media /opt/kittygram/backend/staticfiles
[Install]
WantedBy=multi-user.target
